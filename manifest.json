{
  "manifest_version": 3,
  "name": "AutoFilter",
  "version": "3.0.1",
  "description": "Apply your saved shopping preferences instantly on supported stores.",
  "default_locale": "en",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "dist/background.js" },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "AutoFilter"
  }
}
